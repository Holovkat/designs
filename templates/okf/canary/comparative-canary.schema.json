{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openknowledgeformat.org/schema/okf-comparative-canary-1.schema.json",
  "title": "OKF Comparative Canary 1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "run_id", "created_at", "case_file", "case_sha256", "arms", "trace_dir", "trace_deadline", "passing_case_repetitions", "max_targeted_reruns", "second_failure_outcome"],
  "properties": {
    "version": { "const": "okf-comparative-canary/1" },
    "run_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,95}$" },
    "created_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
    "case_file": { "type": "string", "minLength": 1 },
    "case_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "arms": {
      "type": "array", "minItems": 1, "maxItems": 4,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["name", "type", "enabled"],
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,95}$" },
          "type": { "enum": ["historical-baseline", "prime-fixed-context", "prime-fixed-tools", "prime-adaptive-helper"] },
          "enabled": { "const": true },
          "run_manifest": { "type": "string" }
        }
      }
    },
    "trace_dir": { "type": "string", "minLength": 1 },
    "trace_deadline": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
    "passing_case_repetitions": { "const": 1 },
    "max_targeted_reruns": { "const": 1 },
    "second_failure_outcome": { "const": "revise-or-stop" }
  }
}
