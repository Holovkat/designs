{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openknowledgeformat.org/schema/okf-canary-reviewer-record-1.schema.json",
  "title": "OKF Canary Reviewer Record 1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "case_id", "reviewer_id", "model_identity_visible", "status", "correction_required", "findings", "reviewed_at"],
  "properties": {
    "version": { "const": "okf-canary-reviewer-record/1" },
    "case_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,95}$" },
    "reviewer_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,95}$" },
    "model_identity_visible": { "const": false },
    "status": { "enum": ["accept", "correct", "reject", "disagreement"] },
    "correction_required": { "type": "boolean" },
    "findings": {
      "type": "array", "maxItems": 32,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["category", "message"],
        "properties": {
          "category": { "enum": ["coverage", "target-action", "content", "evidence", "safety", "verbosity"] },
          "message": { "type": "string", "minLength": 1, "maxLength": 1024 }
        }
      }
    },
    "resolution": { "type": ["string", "null"], "maxLength": 2048 },
    "reviewed_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" }
  }
}
