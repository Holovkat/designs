{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openknowledgeformat.org/schema/okf-prime-run-manifest-1.schema.json",
  "title": "OKF Prime Canary Run Manifest 1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version", "run_id", "mode", "root", "revision", "selected_closeout",
    "prime", "model", "network", "credential_source", "prompt_sha256",
    "tool_contract_sha256", "case_sha256", "receipt_path", "limits",
    "retry_ceiling", "approval"
  ],
  "properties": {
    "version": { "const": "okf-prime-run-manifest/1" },
    "run_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,95}$" },
    "mode": { "enum": ["fake-provider", "real-provider"] },
    "root": { "type": "string", "minLength": 1 },
    "revision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "selected_closeout": { "type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$)).+\\.change\\.json$" },
    "receipt_paths": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
    "decision_paths": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
    "resource_paths": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
    "prime": {
      "type": "object", "additionalProperties": false,
      "required": ["version", "package_root", "files"],
      "properties": {
        "version": { "const": "0.7.1" },
        "package_root": { "type": "string", "minLength": 1 },
        "files": {
          "type": "array", "minItems": 3, "uniqueItems": true,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["path", "sha256"],
            "properties": {
              "path": { "type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$)).+$" },
              "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
            }
          }
        }
      }
    },
    "model": {
      "type": "object", "additionalProperties": false,
      "required": ["provider", "id"],
      "properties": {
        "provider": { "type": "string", "minLength": 1 },
        "id": { "type": "string", "minLength": 1 },
        "thinking": { "type": "string" }
      }
    },
    "network": {
      "type": "object", "additionalProperties": false,
      "required": ["broker_endpoint", "tools", "helpers"],
      "properties": {
        "broker_endpoint": { "type": "string", "minLength": 1 },
        "tools": { "const": "none" },
        "helpers": { "const": "none" }
      }
    },
    "credential_source": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "reference"],
      "properties": {
        "kind": { "enum": ["prime-login", "provider-login"] },
        "reference": { "type": "string", "minLength": 1, "maxLength": 256 }
      }
    },
    "prompt_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "tool_contract_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "case_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "receipt_path": { "type": "string", "minLength": 1 },
    "retry_ceiling": { "const": 0 },
    "approval": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "reference"],
      "properties": {
        "status": { "enum": ["not-required-fake", "approved", "rejected"] },
        "reference": { "type": "string", "minLength": 1 }
      }
    },
    "limits": {
      "type": "object", "additionalProperties": false,
      "required": [
        "max_sessions", "max_provider_requests", "max_tool_calls", "max_tool_bytes",
        "max_top_k", "max_input_tokens", "max_output_tokens", "max_total_tokens",
        "max_wall_ms", "max_model_ms", "max_processes", "max_disk_bytes",
        "max_cost_microusd", "max_receipt_bytes"
      ],
      "properties": {
        "max_sessions": { "const": 1 },
        "max_provider_requests": { "type": "integer", "minimum": 1 },
        "max_tool_calls": { "type": "integer", "minimum": 1 },
        "max_tool_bytes": { "type": "integer", "minimum": 1 },
        "max_top_k": { "type": "integer", "minimum": 1, "maximum": 100 },
        "max_input_tokens": { "type": "integer", "minimum": 1 },
        "max_output_tokens": { "type": "integer", "minimum": 1 },
        "max_total_tokens": { "type": "integer", "minimum": 1 },
        "max_wall_ms": { "type": "integer", "minimum": 1 },
        "max_model_ms": { "type": "integer", "minimum": 1 },
        "max_processes": { "const": 1 },
        "max_disk_bytes": { "type": "integer", "minimum": 1 },
        "max_cost_microusd": { "type": "integer", "minimum": 1 },
        "max_receipt_bytes": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
